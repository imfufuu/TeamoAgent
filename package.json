{
  "name": "dubhe-agent",
  "private": true,
  "type": "module",
  "description": "Dubhe Agent — browser-based agent built on the TeamoRouter LLM gateway",
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "test:unit": "node tests/agent.test.mjs",
    "test:list": "node tools/run-tests.mjs --list",
    "eval:nexus": "node tests/run-nexus-eval.mjs",
    "test:dom": "node tests/dom-smoke.mjs",
    "test:app": "node tests/app-boot.mjs",
    "test:live": "node tests/live-smoke.mjs && node tests/live-check.mjs && node tests/live-web.mjs",
    "test:pyodide": "node tests/pyodide-worker.test.mjs",
    "test:kernel": "node tests/execution-kernel-smoke.mjs",
    "start": "python3 server.py",
    "test:server": "python3 tests/server_checks.py",
    "audit:mobile": "node tests/mobile-layout.mjs",
    "test:persist": "node tests/persist.mjs",
    "test:touch": "node tests/touch-density.mjs",
    "test:integrity": "node tests/assets-integrity.mjs",
    "test:browser": "node tests/moderation-browser.mjs",
    "test:p1": "node tests/recovery-kernel-smoke.mjs",
    "test:p2": "node tests/p2-kernel-smoke.mjs && node tests/p2-eval.mjs",
    "test:p3": "node tests/p3-kernel-smoke.mjs && node tests/p3-dom-smoke.mjs",
    "test:worker": "node tests/worker.test.mjs",
    "test:all": "node tools/run-tests.mjs"
  },
  "version": "1.7.0",
  "dependencies": {
    "jsdom": "^29.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
