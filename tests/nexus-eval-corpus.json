{
  "schemaVersion": "1.0.0",
  "benchmarkName": "Teamo-Hermes Nexus (THN v2.1) Offline Evaluation Corpus",
  "description": "独立可复现的离线标注评测集：包含 L1 路由升档判定样本（N=20，含隐式多步漏升 FN 与含触发词闲聊误升 FP 边界样本）与 L3 记忆写入守门人样本（N=20，含短文本高价值事实误杀 FN 与长复合祈使句漏网 FP 边界样本）。",
  "costModel": {
    "routeEscalation": {
      "fnWeight": 5,
      "fpWeight": 1,
      "rationale": "将多约束复杂问题误判进盲快路径（FN 漏升档）会导致跳过记忆召回与核验，代价权重设为 5；将日常寒暄误判进全链路（FP 误升档）仅增加毫秒级本地检索开销，代价权重设为 1。"
    },
    "memoryGatekeeper": {
      "fpWeight": 4,
      "fnWeight": 1,
      "rationale": "将噪声残片或一次性指令写入跨会话记忆（FP 污染）会持续污染后续每一轮系统提示词，代价权重设为 4；漏记单条过短事实（FN 误拦）可由用户显式重试弥补，代价权重设为 1。"
    }
  },
